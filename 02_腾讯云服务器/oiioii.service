[Unit]
Description=OiioiiPool API
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/oiioii
Environment=TUNNEL_ENABLED=false
ExecStart=/usr/bin/python3 -m uvicorn api.server:app --host 0.0.0.0 --port 7861
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
